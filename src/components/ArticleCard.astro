---
import type { CollectionEntry } from 'astro:content';
const { article } = Astro.props as { article: CollectionEntry<'articles'> };
const { title, slug, description, category, publishedAt } = article.data;
---
<article class="card"><p class="category"><a href={`/${category}/`}>{category}</a></p><h3><a href={`/${category}/${slug}/`}>{title}</a></h3><p>{description}</p><time datetime={publishedAt.toISOString()}>{publishedAt.toLocaleDateString('es-ES', { dateStyle: 'medium' })}</time></article>
<style>.card { display: flex; flex-direction: column; min-width: 0; padding: var(--space-4); border: 1px solid var(--color-line); border-radius: var(--radius-md); background: var(--color-surface); box-shadow: var(--shadow-card); transition: border-color 160ms ease, box-shadow 160ms ease, transform 160ms ease; }.card:hover { border-color: color-mix(in srgb, var(--color-brand) 45%, var(--color-line)); box-shadow: var(--shadow-raised); transform: translateY(-2px); }.card h3 { margin: 0 0 var(--space-2); }.card h3 a { color: var(--color-ink); text-decoration: none; }.card p:not(.category) { color: var(--color-muted); font-size: .94rem; }.category { margin: 0 0 var(--space-2); font-size: .75rem; font-weight: 800; letter-spacing: .08em; text-transform: uppercase; }.card time { margin-top: auto; padding-top: var(--space-2); color: var(--color-muted); font-size: .78rem; font-weight: 650; } @media (prefers-reduced-motion: reduce) { .card:hover { transform: none; } }</style>
