---
import { categories, site } from '../data/site';
---
<header class="site-header"><div class="container header-inner">
  <a class="brand" href="/" aria-label={`${site.name}, inicio`}>{site.name}</a>
  <nav aria-label="Navegación principal"><ul>{categories.map(({ slug, name }) => <li><a href={`/${slug}/`}>{name}</a></li>)}</ul></nav>
</div></header>
<style>
  .site-header { background: var(--color-surface); border-bottom: 1px solid var(--color-line); }.header-inner { display: flex; align-items: center; gap: var(--space-3); min-height: 4.25rem; overflow-x: auto; }.brand { color: var(--color-ink); font-size: 1.25rem; font-weight: 800; text-decoration: none; white-space: nowrap; }.site-header ul { display: flex; gap: var(--space-2); margin: 0; padding: 0; list-style: none; }.site-header nav a { color: var(--color-muted); font-size: .875rem; font-weight: 600; text-decoration: none; white-space: nowrap; }.site-header nav a:hover { color: var(--color-brand-dark); }
</style>
