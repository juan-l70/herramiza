---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import { tools } from '../../data/tools';
---
<BaseLayout title="Herramientas digitales | Herramiza" description="Directorio de herramientas digitales para trabajo, estudio y creación."><div class="container section"><Breadcrumbs items={[{ name: 'Inicio', href: '/' }, { name: 'Herramientas' }]} /><header class="tools-header"><p class="eyebrow">Directorio</p><h1>Herramientas digitales</h1><p class="lede">Fichas claras para descubrir, entender y comparar herramientas antes de incorporarlas a tu trabajo o estudio.</p></header><div class="card-grid tools">{tools.map(tool => <article class="tool"><div class="tool-mark" aria-hidden="true">{tool.name.slice(0, 1)}</div><p class="eyebrow">{tool.category} · {tool.pricing}</p><h2><a href={`/herramientas/${tool.slug}/`}>{tool.name}</a></h2><p>{tool.description}</p><a class="tool-link" href={`/herramientas/${tool.slug}/`}>Ver ficha <span aria-hidden="true">→</span></a></article>)}</div></div></BaseLayout>
<style>.tools-header { max-width: 46rem; margin-bottom: var(--space-5); }.tools-header .lede { margin: var(--space-3) 0 0; }.tool { position: relative; min-width: 0; padding: var(--space-4); border: 1px solid var(--color-line); border-radius: var(--radius-md); background: var(--color-surface); }.tool-mark { display: grid; width: 2.8rem; height: 2.8rem; margin-bottom: var(--space-4); place-items: center; border-radius: .75rem; background: var(--color-brand-pale); color: var(--color-brand-dark); font-size: 1.2rem; font-weight: 900; }.tool h2 { margin: 0 0 var(--space-2); }.tool h2 a { color: var(--color-ink); text-decoration: none; }.tool p:not(.eyebrow) { color: var(--color-muted); font-size: .94rem; }.tool-link { margin-top: auto; font-size: .88rem; font-weight: 800; text-decoration: none; }</style>
