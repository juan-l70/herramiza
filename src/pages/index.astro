---
import { getCollection, type CollectionEntry } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import ArticleCard from '../components/ArticleCard.astro';
import { categories } from '../data/site';
import { tools } from '../data/tools';
const articles = ((await getCollection('articles')) as CollectionEntry<'articles'>[]).filter(article => !article.data.draft).sort((a, b) => b.data.publishedAt.valueOf() - a.data.publishedAt.valueOf());
---
<BaseLayout title="Herramiza | Herramientas digitales para hacer más" description="Guías, comparativas y herramientas digitales para estudiar, trabajar y crear mejor.">
  <section class="hero"><div class="container hero-inner"><div><p class="eyebrow">Herramientas digitales para hacer más</p><h1>Elige mejor tus herramientas para avanzar más.</h1><p class="lede">Guías y recomendaciones claras sobre inteligencia artificial, software y productividad para estudiar, trabajar y crear.</p><div class="hero-actions"><a class="button" href="#articulos">Explorar artículos</a><a class="button button--secondary" href="/herramientas/">Ver herramientas</a></div></div><aside class="hero-note" aria-label="Propuesta de Herramiza"><span aria-hidden="true">✦</span><p>Menos ruido. Más criterio para elegir la tecnología que sí te sirve.</p></aside></div></section>
  <section class="section latest" id="articulos"><div class="container"><div class="section-heading"><div><p class="eyebrow">Lecturas recientes</p><h2>Ideas prácticas para tu día digital</h2></div><a href="/ia/">Ver artículos de IA <span aria-hidden="true">→</span></a></div><div class="card-grid">{articles.map(article => <ArticleCard article={article} />)}</div></div></section>
  <section class="section"><div class="container"><div class="section-heading"><div><p class="eyebrow">Explora por tema</p><h2>Encuentra lo que necesitas</h2></div></div><div class="card-grid categories">{categories.map(category => <a class="category-card" href={`/${category.slug}/`}><span aria-hidden="true">↗</span><h3>{category.name}</h3><p>{category.description}</p></a>)}</div></div></section>
  <section class="section discovery"><div class="container discovery-inner"><div><p class="eyebrow">Directorio curado</p><h2>Herramientas que merecen tu tiempo</h2><p class="lede">Fichas breves para entender qué ofrece cada producto antes de incorporarlo a tu rutina.</p><a class="button button--secondary" href="/herramientas/">Explorar el directorio</a></div><div class="tool-list">{tools.slice(0, 3).map(tool => <a href={`/herramientas/${tool.slug}/`}><span>{tool.name.slice(0, 1)}</span><div><strong>{tool.name}</strong><small>{tool.pricing} · {tool.category}</small></div><b aria-hidden="true">→</b></a>)}</div></div></section>
</BaseLayout>
<style>.hero { overflow: clip; padding-block: clamp(4rem, 10vw, 7rem); background: var(--color-ink); color: white; }.hero-inner { display: grid; gap: var(--space-5); }.hero h1 { max-width: 12ch; color: white; }.hero .lede { max-width: 37rem; color: #cddce0; }.hero .eyebrow { color: var(--color-accent); }.hero-actions { display: flex; flex-wrap: wrap; gap: var(--space-2); }.hero .button { background: var(--color-accent); border-color: var(--color-accent); color: var(--color-accent-ink); }.hero .button:hover { background: white; border-color: white; color: var(--color-ink); }.hero .button--secondary { border-color: #6f8794; background: transparent; color: white; }.hero-note { align-self: end; max-width: 20rem; padding: var(--space-4); border: 1px solid #355363; border-radius: var(--radius-md); background: #183649; }.hero-note span { color: var(--color-accent); font-size: 1.5rem; }.hero-note p { margin: var(--space-2) 0 0; color: #e7f0f0; font-family: var(--font-display); font-size: 1.2rem; line-height: 1.25; }.latest { background: var(--color-surface); }.section-heading { display: flex; flex-wrap: wrap; align-items: end; justify-content: space-between; gap: var(--space-3); margin-bottom: var(--space-4); }.section-heading > a { font-size: .9rem; font-weight: 800; }.category-card { position: relative; min-height: 12rem; padding: var(--space-4); border: 1px solid var(--color-line); border-radius: var(--radius-md); background: var(--color-surface); color: var(--color-ink); text-decoration: none; transition: background-color 160ms ease, border-color 160ms ease; }.category-card:hover { border-color: var(--color-brand); background: var(--color-brand-pale); }.category-card > span { position: absolute; top: var(--space-3); right: var(--space-3); color: var(--color-brand); font-size: 1.2rem; }.category-card h3 { max-width: 12ch; margin: var(--space-5) 0 var(--space-2); }.category-card p { margin: 0; color: var(--color-muted); font-size: .92rem; }.discovery { border-top: 1px solid var(--color-line); }.discovery-inner { display: grid; gap: var(--space-5); }.discovery .button { margin-top: var(--space-2); }.tool-list { display: grid; gap: var(--space-2); }.tool-list a { display: grid; grid-template-columns: auto 1fr auto; gap: var(--space-2); align-items: center; padding: var(--space-3); border: 1px solid var(--color-line); border-radius: var(--radius-sm); background: var(--color-surface); color: var(--color-ink); text-decoration: none; }.tool-list a:hover { border-color: var(--color-brand); }.tool-list span { display: grid; width: 2.3rem; height: 2.3rem; place-items: center; border-radius: .6rem; background: var(--color-brand-pale); color: var(--color-brand-dark); font-weight: 900; }.tool-list strong, .tool-list small { display: block; }.tool-list small { color: var(--color-muted); font-size: .78rem; }.tool-list b { color: var(--color-brand); } @media (min-width: 48rem) { .hero-inner { grid-template-columns: minmax(0, 1fr) 18rem; align-items: end; }.discovery-inner { grid-template-columns: minmax(0, 1fr) minmax(17rem, .8fr); align-items: end; } } @media (prefers-reduced-motion: reduce) { .category-card { transition: none; } }</style>
