---
import { getCollection, type CollectionEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ArticleCard from '../../components/ArticleCard.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import { categories } from '../../data/site';
// /herramientas/ es el directorio de fichas de software; las demás entradas son categorías editoriales.
export function getStaticPaths() { return categories.filter(category => category.slug !== 'herramientas').map(category => ({ params: { category: category.slug }, props: { category } })); }
const { category } = Astro.props;
const articles = ((await getCollection('articles')) as CollectionEntry<'articles'>[]).filter(article => article.data.category === category.slug && !article.data.draft).sort((a, b) => b.data.publishedAt.valueOf() - a.data.publishedAt.valueOf());
---
<BaseLayout title={`${category.name} | Herramiza`} description={category.description}><div class="container section"><Breadcrumbs items={[{ name: 'Inicio', href: '/' }, { name: category.name }]} /><header class="category-header"><p class="eyebrow">Categoría</p><h1>{category.name}</h1><p class="lede">{category.description}</p></header><div class="card-grid articles">{articles.map(article => <ArticleCard article={article} />)}</div>{articles.length === 0 && <p class="empty-state">Aún no hay artículos en esta categoría.</p>}</div></BaseLayout>
<style>.category-header { max-width: 45rem; margin-bottom: var(--space-5); }.category-header .lede { margin: var(--space-3) 0 0; }.articles { margin-top: var(--space-4); }.empty-state { padding: var(--space-4); border: 1px dashed var(--color-line); border-radius: var(--radius-md); background: var(--color-surface); color: var(--color-muted); }</style>
